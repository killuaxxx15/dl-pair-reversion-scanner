# Copy this file to .env and fill in the value. .env is gitignored.
# Only needed for `python build_data.py --brief` (the CIO Brief tab).
# The price fetch needs no key at all.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-4-8.
# ANTHROPIC_MODEL=claude-opus-4-8
